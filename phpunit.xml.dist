<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
		 bootstrap="vendor/autoload.php"
		 colors="true">
	<php>
		<ini name="date.timezone" value="America/New_York" />
	</php>
	<source>
		<include>
			<directory suffix=".php">src</directory>
		</include>
	</source>
	<coverage>
		<report>
			<clover outputFile="coverage.xml"/>
		</report>
	</coverage>
	<testsuites>
		<testsuite name="generic tests">
			<file>tests/GenericTest.php</file>
			<file>tests/DetachTest.php</file>
			<file>tests/LogBackTraceRedactionTest.php</file>
			<file>tests/Mysqli/TransactionRetryTest.php</file>
			<file>tests/Mysqli/TransactionReplayTest.php</file>
			<file>tests/Mysqli/TransactionSafetyTest.php</file>
			<file>tests/Mysqli/TransactionOwnEndTest.php</file>
			<file>tests/Mysqli/TransactionUnknownEndTest.php</file>
			<file>tests/ErrorReportRedactionTest.php</file>
		</testsuite>
		<testsuite name="mysql tests">
			<file>tests/GenericTest.php</file>
			<file>tests/Mysqli/DbTest.php</file>
			<file>tests/DetachTest.php</file>
			<file>tests/LogBackTraceRedactionTest.php</file>
			<file>tests/Mysqli/TransactionRetryTest.php</file>
			<file>tests/Mysqli/TransactionReplayTest.php</file>
			<file>tests/Mysqli/TransactionSafetyTest.php</file>
			<file>tests/Mysqli/TransactionOwnEndTest.php</file>
			<file>tests/Mysqli/TransactionUnknownEndTest.php</file>
			<file>tests/ErrorReportRedactionTest.php</file>
			<file>tests/Mdb2/DbTest.php</file>
			<file>tests/Pdo/DbTest.php</file>
		</testsuite>
		<testsuite name="postgresql tests">
			<file>tests/Pgsql/DbTest.php</file>
		</testsuite>
		<testsuite name="all tests">
			<file>tests/GenericTest.php</file>
			<file>tests/Mysqli/DbTest.php</file>
			<file>tests/DetachTest.php</file>
			<file>tests/LogBackTraceRedactionTest.php</file>
			<file>tests/Mysqli/TransactionRetryTest.php</file>
			<file>tests/Mysqli/TransactionReplayTest.php</file>
			<file>tests/Mysqli/TransactionSafetyTest.php</file>
			<file>tests/Mysqli/TransactionOwnEndTest.php</file>
			<file>tests/Mysqli/TransactionUnknownEndTest.php</file>
			<file>tests/ErrorReportRedactionTest.php</file>
			<file>tests/Mdb2/DbTest.php</file>
			<file>tests/Pdo/DbTest.php</file>
			<file>tests/Pgsql/DbTest.php</file>
		</testsuite>
	</testsuites>
</phpunit>
